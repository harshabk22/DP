# MessMate Backend Environment Configuration
DATABASE_URL=sqlite+aiosqlite:///./messmate.db
SYNC_DATABASE_URL=sqlite:///./messmate.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-this-to-a-secure-random-key-in-production-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# Google Gemini API Key for Live Multimodal Food Perception
# Obtain your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
